{
  "$comment": "Single source of truth for design tokens. Mirrored as CSS variables in src/styles/index.css and intended to map 1:1 to a SwiftUI Theme (see docs/SWIFT_PORT.md).",
  "color": {
    "dark": {
      "bg": "#0c0c0e",
      "surface": "#141417",
      "surface2": "#1c1c21",
      "line": "rgba(255,255,255,0.08)",
      "text": "#f4f4f5",
      "text2": "#a8a8b0",
      "text3": "#83838c",
      "accent": "#f2b33d",
      "accentText": "#f2b33d",
      "onAccent": "#1a1204",
      "danger": "#ff6b5e"
    },
    "light": {
      "bg": "#f6f6f7",
      "surface": "#ffffff",
      "surface2": "#ebebee",
      "line": "rgba(10,10,14,0.09)",
      "text": "#17171a",
      "text2": "#4f4f57",
      "text3": "#64646d",
      "accent": "#e09a1a",
      "accentText": "#8f5400",
      "onAccent": "#1a1204",
      "danger": "#c4301f"
    }
  },
  "radius": {
    "$rule": "Interactive controls are full pills. Media cards and panels are 12px. Inputs and menus are 12px. Small chips are pills.",
    "card": 12,
    "panel": 20,
    "control": 999
  },
  "spacing": { "gutter": 16, "gutterLg": 48, "rowGap": 40 },
  "type": {
    "family": "Geist Variable",
    "mono": "Geist Mono Variable",
    "display": { "size": 56, "lineHeight": 1.02, "tracking": -0.035, "weight": 650 },
    "title1": { "size": 34, "lineHeight": 1.08, "tracking": -0.025, "weight": 620 },
    "title2": { "size": 22, "lineHeight": 1.2, "tracking": -0.015, "weight": 600 },
    "body": { "size": 16, "lineHeight": 1.55, "tracking": 0, "weight": 420 },
    "caption": { "size": 13, "lineHeight": 1.4, "tracking": 0.005, "weight": 500 }
  },
  "motion": {
    "$rule": "Springs, never fixed-duration curves, for anything a user touches. Critically damped by default; bounce only after momentum.",
    "springDefault": { "bounce": 0, "duration": 0.4 },
    "springSnappy": { "bounce": 0, "duration": 0.28 },
    "springMomentum": { "bounce": 0.18, "duration": 0.45 },
    "pressScale": 0.97
  }
}
