{
  // Cloudflare Workers static-assets deployment. Serves the Vite build from ./dist.
  // "single-page-application" returns index.html for unknown paths so deep links
  // like /title/movie/123 work on refresh.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finnhub",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
